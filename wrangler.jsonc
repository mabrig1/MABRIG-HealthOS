{
  "name": "mabrig-healthos",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "build": {
    "command": "npm run build"
  },
  "main": "worker/index.mjs",
  "vars": {
    "EVIDENCE_ENABLED": "false",
    "SWARM_COUNCIL_ENABLED": "false",
    "HEALTH_AI_ENABLED": "false",
    "CF_AI_FREE_PLAN_CONFIRMED": "false",
    "FREELLMAPI_ENABLED": "false",
    "FREELLMAPI_FREE_PROFILE_CONFIRMED": "false",
    "DIARY_ENABLED": "false"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HEALTH_AI_QUOTA",
        "class_name": "HealthAIQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "health-ai-v1",
      "new_sqlite_classes": [
        "HealthAIQuota"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "HEALTHOS_STORAGE",
      "bucket_name": "healthos-storage"
    }
  ]
}
